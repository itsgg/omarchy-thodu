{"case": "two frames of one process: the active one", "window": {"address": "0x1", "class": "chromium", "title": "t", "pid": 100, "at": [0, 0], "size": [800, 600], "workspace": 1, "monitor": 0}, "apps": [{"name": "Chromium", "pid": 100, "frames": [{"role": "frame", "name": "A", "states": ["showing", "visible"], "extents": [0, 0, 800, 600], "children": []}, {"role": "frame", "name": "B", "states": ["showing", "visible", "active"], "extents": [0, 0, 800, 600], "children": []}]}], "expected": "B"}
{"case": "an app whose name is not its class, matched by process", "window": {"address": "0x1", "class": "org.telegram.desktop", "title": "t", "pid": 200, "at": [0, 0], "size": [640, 480], "workspace": 1, "monitor": 0}, "apps": [{"name": "TelegramDesktop", "pid": 200, "frames": [{"role": "frame", "name": "Telegram", "states": ["showing", "visible"], "extents": [0, 0, 640, 480], "children": []}]}], "expected": "Telegram"}
{"case": "another process's frame is never chosen", "window": {"address": "0x1", "class": "app", "title": "t", "pid": 300, "at": [0, 0], "size": [640, 480], "workspace": 1, "monitor": 0}, "apps": [{"name": "app", "pid": 301, "frames": [{"role": "frame", "name": "Other", "states": ["showing", "visible"], "extents": [0, 0, 640, 480], "children": []}]}], "expected": null}
{"case": "two inactive frames: the one of the window's size", "window": {"address": "0x1", "class": "app", "title": "t", "pid": 400, "at": [0, 0], "size": [300, 200], "workspace": 1, "monitor": 0}, "apps": [{"name": "app", "pid": 400, "frames": [{"role": "frame", "name": "Big", "states": ["showing", "visible"], "extents": [0, 0, 800, 600], "children": []}, {"role": "frame", "name": "Small", "states": ["showing", "visible"], "extents": [0, 0, 300, 200], "children": []}]}], "expected": "Small"}
{"case": "a frame that is not showing is skipped, active or not", "window": {"address": "0x1", "class": "app", "title": "t", "pid": 500, "at": [0, 0], "size": [300, 200], "workspace": 1, "monitor": 0}, "apps": [{"name": "app", "pid": 500, "frames": [{"role": "frame", "name": "Gone", "states": ["active"], "extents": [0, 0, 300, 200], "children": []}, {"role": "frame", "name": "Here", "states": ["showing", "visible"], "extents": [0, 0, 300, 200], "children": []}]}], "expected": "Here"}
