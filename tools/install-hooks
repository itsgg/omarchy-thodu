#!/bin/sh
# Install each .githooks/<name> as a shim in the repository's hooks directory.
# The shim runs the copy in whichever worktree git is in, so a sandboxed agent
# worktree runs its own hooks. Safe to run again; tools/gate checks the result.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
# Copier also renders a template into scratch directories while updating;
# there is nothing to install there, and the gate's hooks step checks the result.
if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "not a git repository; no hooks installed"
    exit 0
fi
if [ -n "$(git config --local --get core.hooksPath || true)" ]; then
    echo "ERROR a local core.hooksPath hides .git/hooks; run: git config --local --unset core.hooksPath" >&2
    exit 1
fi
hooks="$(git rev-parse --path-format=absolute --git-common-dir)/hooks"
mkdir -p "$hooks"
# A shim whose hook the template no longer has would run a missing file.
for shim in "$hooks"/*; do
    [ -f "$shim" ] || continue
    grep -q '^# Installed by tools/install-hooks;' "$shim" || continue
    [ -e ".githooks/$(basename "$shim")" ] || rm -f -- "$shim"
done
for hook in .githooks/*; do
    name=$(basename "$hook")
    printf '#!/bin/sh\n# Installed by tools/install-hooks; runs this worktree'"'"'s .githooks copy.\nexec "$(git rev-parse --show-toplevel)/.githooks/%s" "$@"\n' "$name" >"$hooks/$name"
    chmod +x "$hooks/$name"
done
echo "hooks installed in $hooks"
